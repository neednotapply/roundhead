    "id": "field name in the generated BuildStats class",
    "type": "float | int | bool | color",
    "component": "ROUNDS component on the card prefab the value is read from",
    "field": "field on that component",
    "op": "mult | add | add_clamp_1_90 | proj_weighted_mult | or_true | and_false | set_nonzero | color_mix | lock_attack",
    "base": "value of a fresh ROUNDS player (Gun/GunAmmo/CharacterStatModifiers/Block ResetStats)",
    "effect": "effects.id that uses it in Cuphead"
  },
